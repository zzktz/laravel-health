{
  "name": "zzktz/laravel-health",
  "description": "为 Laravel 8 及以上版本提供符合统一契约的存活与就绪健康检查接口。",
  "type": "library",
  "license": "MIT",
  "keywords": ["laravel", "health-check", "readiness", "liveness"],
  "require": {
    "php": "^7.4|^8.0",
    "illuminate/database": "^8.30|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^8.30|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/redis": "^8.30|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/routing": "^8.30|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^8.30|^9.0|^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.4",
    "orchestra/testbench": "^6.23",
    "phpunit/phpunit": "^9.3"
  },
  "autoload": {
    "psr-4": {
      "Zzktz\\LaravelHealth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zzktz\\LaravelHealth\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Zzktz\\LaravelHealth\\LaravelHealthServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
